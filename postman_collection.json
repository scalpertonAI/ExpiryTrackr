{
  "info": {
    "name": "ExpiryTrackr API",
    "description": "API endpoints for ExpiryTrackr",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/signup",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/items",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items"]
            }
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Passport\",\n  \"item_type\": \"document\",\n  \"source_type\": \"manual\",\n  \"primary_expiry\": \"2025-12-31\",\n  \"notes\": \"Renewal required\",\n  \"reminder_windows\": [30, 7, 1]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/items",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items"]
            }
          }
        },
        {
          "name": "Get Item by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/items/:id",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{ITEM_ID}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Passport\",\n  \"notes\": \"Updated notes\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/items/:id",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{ITEM_ID}}"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/items/:id",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{ITEM_ID}}"
                }
              ]
            }
          }
        },
        {
          "name": "Upload and Extract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/api/items/upload",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "items", "upload"]
            }
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"pro\",\n  \"billingCycle\": \"monthly\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/billing/create-order",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "billing", "create-order"]
            }
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order_xxx\",\n  \"paymentId\": \"pay_xxx\",\n  \"signature\": \"signature_xxx\",\n  \"plan\": \"pro\",\n  \"billingCycle\": \"monthly\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/billing/verify",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "billing", "verify"]
            }
          }
        },
        {
          "name": "Get Plan Usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/billing/usage",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "billing", "usage"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/admin/stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "your_access_token_here"
    },
    {
      "key": "ADMIN_ACCESS_TOKEN",
      "value": "your_admin_token_here"
    },
    {
      "key": "ITEM_ID",
      "value": "item_id_here"
    }
  ]
}
